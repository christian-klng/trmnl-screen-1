# Copy to .env for local development. On Railway set these as service variables.

# --- Nextcloud / CalDAV ---------------------------------------------------
# Use an app password, never the account password.
CALDAV_URL=https://cloud.example.com/remote.php/dav
CALDAV_USERNAME=christian
CALDAV_PASSWORD=app-password-here

# Calendar display names, comma separated. Empty means every calendar the
# account can see. Max 5 is what the layout is designed for.
CALDAV_CALENDARS=Privat,Arbeit,Familie

# --- Direct ICS/webcal URLs -----------------------------------------------
# Fetched on our own schedule, bypassing Nextcloud. Use this for calendars
# that would otherwise sit behind a slow Nextcloud subscription job — a Google
# secret iCal address, for instance.
# Format: Name=URL, comma separated. A bare URL also works.
# ICS_URLS=Google=https://calendar.google.com/calendar/ical/…/basic.ics

# At least one of CALDAV_* or ICS_URLS must be set.

# --- Runtime --------------------------------------------------------------
# Locally point this at a writable directory; on Railway it is the volume
# mount path.
DATA_DIR=./data

# Absolute URL the device should fetch from. On Railway this is derived from
# RAILWAY_PUBLIC_DOMAIN automatically and can stay empty.
PUBLIC_BASE_URL=

# --- Pairing protection ---------------------------------------------------
# The TRMNL firmware can only be given a base URL, so it cannot send a custom
# header. These are the protections that actually work under that constraint.

# Mounts the whole API under a secret path. The device URL then becomes
# https://your-app.up.railway.app/s/<something-long-and-random> and the URL
# itself is the credential.
# URL_PREFIX=

# Only these MAC addresses may pair. Comma separated, empty means any.
# ALLOWED_MACS=AA:BB:CC:DD:EE:FF

# Once one device has paired, refuse to register any other. On by default.
# LOCK_AFTER_FIRST_PAIRING=true

# Optional extra for clients that can send a header or query parameter. The
# TRMNL firmware cannot, so on its own this protects nothing.
PAIRING_SECRET=

# --- Panel health ---------------------------------------------------------
# The firmware draws a 1-bit image with a partial, flicker-free update. Without
# a black/white wipe now and then the panel washes out over weeks, and the
# firmware's own periodic wipe does not fire for a BYOS screen. So we ask for
# one ourselves, on every Nth redraw and on the first redraw of each day.
# Set it to 1 for a day to scrub an already washed-out panel back to contrast.
# FULL_REFRESH_EVERY=8

# Waveform profile the firmware should keep: default, a or b. This is the
# "Device settings > Firmware" switch, which a BYOS device cannot otherwise
# reach. This display needs "a". Under "default" the firmware never writes the
# controller's copy of the old image, so every full refresh is driven from
# noise and the screen comes back pale until the following partial updates
# repair it. "b" is pointless on the OG for a 1-bit screen: same panel type as
# "default". The README explains the mechanism.
# TEMPERATURE_PROFILE=a

# png or bmp. PNG is what the firmware decodes natively and is ~20x smaller;
# bmp exists as an escape hatch.
# IMAGE_FORMAT=png

# --- Firmware -------------------------------------------------------------
# Version the display should run, e.g. 1.8.16. On its next poll the device
# downloads TRMNL's release image and updates itself over WiFi, keeping its
# WiFi and server settings. Offered only while the device reports an older
# version, never as a downgrade. Empty means no updates.
# FIRMWARE_TARGET=1.8.16
# Override the download location. Leave empty for TRMNL's own release image.
# FIRMWARE_URL=
# Minimum hours between two offers to the same device.
# FIRMWARE_RETRY_HOURS=6

# --- Optional tuning ------------------------------------------------------
# TIMEZONE=Europe/Berlin
# DISPLAY_REFRESH_SECONDS=900
# Minutes of the hour to refresh calendars on, comma separated.
# FETCH_AT_MINUTES=0,30
# QUIET_START_HOUR=23
# QUIET_END_HOUR=5
# WEEK_SWITCH_WEEKDAY=6
# WEEK_SWITCH_HOUR=12
# GRID_MIN_HOURS=8
# GRID_MAX_HOURS=15
# LOG_LEVEL=INFO
