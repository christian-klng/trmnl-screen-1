# Copy to .env for local development. On Railway set these as service variables.

# --- Nextcloud / CalDAV (required) ---------------------------------------
# Use an app password, never the account password.
CALDAV_URL=https://cloud.example.com/remote.php/dav
CALDAV_USERNAME=christian
CALDAV_PASSWORD=app-password-here

# Calendar display names, comma separated. Empty means every calendar the
# account can see. Max 5 is what the layout is designed for.
CALDAV_CALENDARS=Privat,Arbeit,Familie

# --- Runtime --------------------------------------------------------------
# Locally point this at a writable directory; on Railway it is the volume
# mount path.
DATA_DIR=./data

# Absolute URL the device should fetch from. On Railway this is derived from
# RAILWAY_PUBLIC_DOMAIN automatically and can stay empty.
PUBLIC_BASE_URL=

# Recommended on a public host: without it, anyone who finds /api/setup can
# register themselves as a device.
PAIRING_SECRET=

# --- Optional tuning ------------------------------------------------------
# TIMEZONE=Europe/Berlin
# DISPLAY_REFRESH_SECONDS=900
# FETCH_INTERVAL_MINUTES=9
# QUIET_START_HOUR=23
# QUIET_END_HOUR=5
# WEEK_SWITCH_WEEKDAY=6
# WEEK_SWITCH_HOUR=12
# GRID_MIN_HOURS=8
# GRID_MAX_HOURS=15
# LOG_LEVEL=INFO
